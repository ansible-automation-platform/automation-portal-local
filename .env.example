# Automation Portal Local — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Almost like AAP (default: local mock, no real Controller) ──
# Set AAP_MOCK=0 and point AAP_* at a lab Controller to use real AAP.
AAP_MOCK=1
AAP_HOST_URL=http://aap-mock:8099
AAP_PUBLIC_URL=http://localhost:8099
AAP_TOKEN=local-mock-token
OAUTH_CLIENT_ID=portal-local-mock
OAUTH_CLIENT_SECRET=portal-local-mock-secret
AAP_MOCK_USERNAME=user
AAP_MOCK_PASSWORD=password

# ── GitHub SCM Integration (optional for mock-only UI; required for real SCM) ──
# GITHUB_TOKEN=<your-github-pat>

# ── GitHub OAuth (optional) ──
# Callback URL: http://localhost:7007/api/auth/github/handler/frame
# GITHUB_OAUTH_CLIENT_ID=<your-github-oauth-client-id>
# GITHUB_OAUTH_CLIENT_SECRET=<your-github-oauth-client-secret>

# ── GitLab (optional) ──
# GITLAB_TOKEN=<your-gitlab-pat>
# GITLAB_OAUTH_CLIENT_ID=<your-gitlab-oauth-client-id>
# GITLAB_OAUTH_CLIENT_SECRET=<your-gitlab-oauth-client-secret>

# ── APME Container Images ──
APME_IMAGE_TAG=latest
# Abbenay image (bundled compose only). Host tox -e up uses APME's pod.yaml pin.
# ABBENAY_IMAGE_TAG=v2026.8.1
# On ARM hosts (macOS Apple Silicon), start.sh auto-sets this.
# APME_PLATFORM=linux/amd64

# Shared token for Primary/Gateway ↔ Abbenay (must match .env-abbenay).
# APME_ABBENAY_TOKEN=apme-dev-token
# Optional default AI model when using bundled Abbenay
# APME_AI_MODEL=openrouter/anthropic/claude-sonnet-4

# Native APME SPA (side-by-side with Portal). Default on when unset.
# Set to 0 / false / off to skip starting apme-ui. Forced off when APME_EXTERNAL=1.
# APME_UI=1
# APME_UI_PORT=8081

# Use an already-running APME Gateway instead of compose apme-* services.
# When set, COMPOSE_PROFILES omits "apme" / "apme-ui" and RHDH uses APME_BASE_URL.
# APME_EXTERNAL=0
# Default baseUrl when bundled: http://apme-gateway:8080
# Default baseUrl when APME_EXTERNAL=1: http://host.containers.internal:8080
# APME_BASE_URL=http://apme-gateway:8080

# Bundled Abbenay provider keys (APME_EXTERNAL=0): copy and edit
#   cp .env-abbenay.example .env-abbenay
# External APME: use the host APME checkout containers/abbenay/.env instead.

# ── Portal UI ──
# CUSTOMER_SUPPORT_URL=https://access.redhat.com/support

# ── Plugin source (required for ./scripts/start-dev.sh) ──
PLUGIN_REPO=/home/YOU/github/ansible-backstage-plugins

# ── RHDH Settings ──
RHDH_IMAGE=quay.io/rhdh-community/rhdh:1.10
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Database (defaults are fine for local dev) ──
# POSTGRES_PASSWORD=postgres
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
