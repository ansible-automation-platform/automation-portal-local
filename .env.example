# Automation Portal Local — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Almost like AAP (default: local mock, no real Controller) ──
# Set AAP_MOCK=0 and point AAP_* at a lab Controller to use real AAP.
AAP_MOCK=1
# Reachable from RHDH and from the host APME pod (make apme / tox -e up).
# Do not use http://aap-mock:8099 — APME cannot resolve compose DNS.
AAP_HOST_URL=http://host.containers.internal:8099
AAP_PUBLIC_URL=http://localhost:8099
AAP_TOKEN=local-mock-token
OAUTH_CLIENT_ID=portal-local-mock
OAUTH_CLIENT_SECRET=portal-local-mock-secret
AAP_MOCK_USERNAME=user
AAP_MOCK_PASSWORD=password

# Optional console Hub offline/refresh token for certified/validated remotes.
# Same value ansible-galaxy uses with auth_url (console.redhat.com → Automation Hub → Connect).
# aap-mock exchanges it via SSO for a short-lived Bearer access token.
# Without this, Hub remotes are skipped and only galaxy.ansible.com is used.
# AAP_MOCK_HUB_TOKEN=
# AAP_MOCK_HUB_BASE=https://console.redhat.com/api/automation-hub
# AAP_MOCK_HUB_AUTH_URL=https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
# AAP_MOCK_HUB_AUTH_CLIENT_ID=cloud-services
# AAP_MOCK_GALAXY_BASE=https://galaxy.ansible.com

# ── GitHub SCM Integration (optional for mock-only UI; required for real SCM) ──
# GITHUB_TOKEN=<your-github-pat>

# ── GitHub OAuth (optional) ──
# Callback URL: http://localhost:7007/api/auth/github/handler/frame
# GITHUB_OAUTH_CLIENT_ID=<your-github-oauth-client-id>
# GITHUB_OAUTH_CLIENT_SECRET=<your-github-oauth-client-secret>

# ── GitLab (optional) ──
# GITLAB_TOKEN=<your-gitlab-pat>
# GITLAB_OAUTH_CLIENT_ID=<your-gitlab-oauth-client-id>
# GITLAB_OAUTH_CLIENT_SECRET=<your-gitlab-oauth-client-secret>

# ── APME (started via `make apme` → tox -e up in APME_REPO) ──
# Portal-only mode: no APME plugins; skip make apme (IAG / customer delivery).
# PORTAL_ONLY=0
#
# Clone path for the APME pod (default: $HOME/github/apme).
# APME_REPO=/home/YOU/github/apme
#
# Gateway URL as seen from the RHDH container (default when PORTAL_ONLY!=1).
# APME_BASE_URL=http://host.containers.internal:8080
#
# Abbenay / AI provider keys live in the APME checkout:
#   containers/abbenay/.env

# ── Portal UI ──
# CUSTOMER_SUPPORT_URL=https://access.redhat.com/support

# ── Plugin source (required for make dev / make start) ──
PLUGIN_REPO=/home/YOU/github/ansible-backstage-plugins

# ── RHDH Settings ──
RHDH_IMAGE=quay.io/rhdh-community/rhdh:1.10
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Extensions catalog lab (`make extensions`) ──
# Put YOUR Quay namespace here (gitignored .env). Do not commit personal URLs.
# Package APME OCI first, then: podman login quay.io && make extensions-index
# See docs/deployment-modes.md.
# EXTENSIONS_CATALOG_INDEX=quay.io/<ns>/portal-plugin-catalog-index:dev
# APME_FRONTEND_OCI=quay.io/<ns>/plugin-backstage-apme:dev
# APME_BACKEND_OCI=quay.io/<ns>/plugin-catalog-backend-module-apme:dev

# ── Database (defaults are fine for local development) ──
# POSTGRES_PASSWORD=postgres
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
