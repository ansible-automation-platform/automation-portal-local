# Automation Portal Local — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AAP Connection (required) ──
AAP_HOST_URL=https://aap.example.com
AAP_TOKEN=<your-aap-token>
OAUTH_CLIENT_ID=<your-oauth-client-id>
OAUTH_CLIENT_SECRET=<your-oauth-client-secret>

# ── GitHub SCM Integration (required for templates/repos) ──
GITHUB_TOKEN=<your-github-pat>

# ── GitHub OAuth (optional, for GitHub sign-in alongside RHAAP) ──
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:7007/api/auth/github/handler/frame
# GITHUB_OAUTH_CLIENT_ID=<your-github-oauth-client-id>
# GITHUB_OAUTH_CLIENT_SECRET=<your-github-oauth-client-secret>

# ── GitLab (optional, uncomment if using GitLab) ──
# GITLAB_TOKEN=<your-gitlab-pat>
# GITLAB_OAUTH_CLIENT_ID=<your-gitlab-oauth-client-id>
# GITLAB_OAUTH_CLIENT_SECRET=<your-gitlab-oauth-client-secret>

# ── APME Container Images ──
APME_IMAGE_TAG=latest
# On ARM hosts (macOS Apple Silicon), start.sh auto-sets this.
# On x86_64 (Fedora, CentOS, RHEL), leave unset — native images are used.
# APME_PLATFORM=linux/amd64

# ── RHDH Settings ──
RHDH_IMAGE=quay.io/rhdh-community/rhdh:1.10
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Database (defaults are fine for local dev) ──
# POSTGRES_PASSWORD=postgres
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
