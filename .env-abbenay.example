# Abbenay provider secrets for the bundled compose APME stack (APME_EXTERNAL=0).
# Copy to .env-abbenay (gitignored) and fill in keys:
#   cp .env-abbenay.example .env-abbenay
#
# make start / make dev syncs this file into rhdh-local/ for the apme-abbenay
# container (env_file). Restart apme-abbenay after changing keys.
#
# When APME_EXTERNAL=1, this file is unused — put keys in the host APME
# checkout: containers/abbenay/.env (tox -e up).

# Consumer / admin token — must match APME_ABBENAY_TOKEN in .env (default below).
APME_ABBENAY_TOKEN=apme-dev-token

# Optional default model for Primary (provider/model composite id)
# APME_AI_MODEL=openrouter/anthropic/claude-sonnet-4

# --- OpenRouter ---
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Corporate Vertex Anthropic proxy ---
# VERTEX_ANTHROPIC_API_KEY=

# --- Direct Vertex AI (GCP ADC) ---
# Note: compose does not auto-mount GCP credentials JSON. Prefer OpenRouter
# for local Portal, or use APME_EXTERNAL=1 with host tox -e up + ABBENAY_GCP_CREDENTIALS.
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=us-east5
